##############################################

# Ignore sensitive variable files
*.auto.tfvars
*.auto.tfvars.json

# Optional: Uncomment if your tfvars contains secrets
# *.tfvars
# *.tfvars.json

##############################################
# Sensitive credentials
##############################################

# Service account keys
*.json
!*.example.json

# Environment files
.env
.env.*

