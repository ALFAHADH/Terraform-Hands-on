##############################################
# Terraform
##############################################

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
plan.out

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

##############################################
